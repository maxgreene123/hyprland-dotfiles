#!/usr/bin/env python3
"""Keep the user's Discord installation patched with official Vencord releases."""
import fcntl
import hashlib
import json
import os
from pathlib import Path
import subprocess
import time
import urllib.request

home = Path.home()
config = Path(os.environ.get('XDG_CONFIG_HOME', home / '.config'))
state = Path(os.environ.get('XDG_STATE_HOME', home / '.local/state')) / 'vencord-maintain'
state.mkdir(parents=True, exist_ok=True)

def fetch(url):
    request = urllib.request.Request(url, headers={'User-Agent': 'vencord-maintain'})
    with urllib.request.urlopen(request, timeout=45) as response:
        return response.read()

def patched(resources):
    app = resources / 'app.asar'
    return (resources / '_app.asar').is_file() and app.is_file() and b'Vencord' in app.read_bytes()[:16384]

def main():
    with (state / 'lock').open('w') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return
        installs = sorted((config / 'discord').glob('app-*/resources'))
        if not installs:
            print('Discord is not installed in the expected user directory.')
            return
        resources = installs[-1]
        app = resources / 'app.asar'
        if not app.is_file() or time.time() - app.stat().st_mtime < 90:
            print('Discord update is still settling; retry on the next timer run.')
            return
        marker = state / 'last-check'
        due = not marker.exists() or time.time() - marker.stat().st_mtime >= 39600
        missing = not patched(resources)
        if not missing and not due:
            print('Vencord patch is present; twice-daily update check is not due.')
            return
        release = json.loads(fetch('https://api.github.com/repos/Vendicated/Vencord/releases/latest'))
        expected = release['name'].rsplit(' ', 1)[-1]
        patcher = config / 'Vencord/dist/patcher.js'
        current = patcher.open().readline().strip().removeprefix('// Vencord ') if patcher.is_file() else ''
        if not missing and current == expected:
            marker.touch()
            print('Vencord is current and Discord is patched.')
            return
        installer_release = json.loads(fetch('https://api.github.com/repos/Vencord/Installer/releases/latest'))
        asset = next(a for a in installer_release['assets'] if a['name'] == 'VencordInstallerCli-linux')
        digest = asset.get('digest', '')
        if not digest.startswith('sha256:'):
            raise RuntimeError('Installer release has no SHA-256 digest; refusing unchecked download.')
        binary = fetch(asset['browser_download_url'])
        if hashlib.sha256(binary).hexdigest() != digest.split(':', 1)[1]:
            raise RuntimeError('Installer checksum mismatch.')
        installer = state / 'installer'
        temporary = state / 'installer.new'
        temporary.write_bytes(binary)
        temporary.chmod(0o700)
        temporary.replace(installer)
        subprocess.run([str(installer), '--install', '--location', str(config / 'discord')], check=True, timeout=180)
        if not patched(resources):
            raise RuntimeError('Installer finished, but the Discord patch could not be verified.')
        installed = patcher.open().readline().strip().removeprefix('// Vencord ')
        if installed != expected:
            raise RuntimeError('Vencord release verification failed; retry on the next timer run.')
        marker.touch()
        print('Vencord updated and patched. Restart Discord to load it.')

if __name__ == '__main__':
    main()
